{
  "name": "coverage-check",
  "version": "0.15.3",
  "description": "Patch-coverage gate: checks that newly added lines meet per-path coverage thresholds. Supports per-suite LCOV accumulation for conditional CI.",
  "license": "MIT",
  "author": "Jonathan Ong",
  "type": "module",
  "bin": {
    "coverage-check": "./bin/coverage-check.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/src/coverage-check.d.mts",
      "import": "./dist/src/coverage-check.mjs"
    },
    "./vitest": {
      "types": "./dist/src/vitest.d.mts",
      "import": "./dist/src/vitest.mjs"
    },
    "./src/*.mts": {
      "types": "./dist/src/*.d.mts",
      "import": "./dist/src/*.mjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "types": "./dist/src/coverage-check.d.mts",
  "files": [
    "dist/**",
    "bin/coverage-check.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1111.0",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@smithy/node-http-handler": "^4.7.7",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.2.1",
    "minimatch": "^10.1.1",
    "monocart-coverage-reports": "^2.12.11"
  },
  "peerDependencies": {
    "@vitest/coverage-v8": ">=3.2.0 <5",
    "vitest": ">=3.2.0 <5"
  },
  "peerDependenciesMeta": {
    "@vitest/coverage-v8": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "husky": "^9.1.7",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.65.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.6"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsc --project tsconfig.build.json",
    "prepublishOnly": "npm run build && npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/ bin/",
    "format": "oxfmt src/ bin/ README.md",
    "format:check": "oxfmt --check src/ bin/ README.md",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "coverage",
    "lcov",
    "patch-coverage",
    "github",
    "ci",
    "test-coverage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathanong/coverage-check.git"
  },
  "bugs": {
    "url": "https://github.com/jonathanong/coverage-check/issues"
  },
  "homepage": "https://github.com/jonathanong/coverage-check"
}
